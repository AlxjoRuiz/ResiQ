# Copiar a .env.local y completar desde un proyecto Supabase de desarrollo.
# En Vercel, las mismas variables van en Settings › Environment Variables.

# Públicas (viajan al navegador): URL del proyecto y clave sb_publishable_.
# Nunca colocar aquí una clave secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo en servidor: clave sb_secret_ para publicar archivos después de validarlos
# y firmar la cookie de acceso de 60 s (src/lib/supabase/proxy.ts).
# Nunca usar NEXT_PUBLIC_ para esta variable.
SUPABASE_SECRET_KEY=

# Habilitar solo después de configurar SMTP propio en Supabase Auth,
# verificar el dominio remitente y configurar la plantilla de recuperación.
PASSWORD_RECOVERY_ENABLED=false

# Solo en servidor: respuestas de los residentes al requerimiento de pago del módulo jurídico
# (webhook de Resend en /api/legal/inbound). Sin ellas esa ruta responde 503; el resto funciona.
# RESEND_INBOUND_WEBHOOK_SECRET es el «Signing secret» del webhook (empieza por whsec_).
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=

# Las variables de la función de correos (RESEND_FROM_EMAIL, EMAIL_WORKER_SECRET, APP_URL,
# LEGAL_REPLY_DOMAIN) no van en este archivo: se guardan en Supabase › Edge Functions › Secrets.
# Ver supabase/functions/process-email-jobs/README.md.

# Opcional, solo para la prueba e2e (npm run test:e2e): URL del servidor local ya encendido.
# RESIQ_TEST_BASE_URL=http://127.0.0.1:3000
